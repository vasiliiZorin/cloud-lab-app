# App server
PORT=3000

# Database tier (PostgreSQL) — durable storage
PGHOST=localhost
PGPORT=5432
PGUSER=cloudlab
PGPASSWORD=change-me
PGDATABASE=cloudlab
# Set to "require" for managed Postgres (Azure Flexible Server, AWS RDS —
# both enforce/expect TLS in this repo's configs). Leave unset for
# self-hosted Postgres on a private subnet (Acronis).
PGSSLMODE=

# Cache tier (Redis) — fast, ephemeral counters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" for managed Redis with transit encryption (Azure Cache's
# SSL port, AWS ElastiCache with transit_encryption_enabled). Leave unset
# for self-hosted Redis on a private subnet (Acronis).
REDIS_TLS=
