# App server
PORT=3000

# Database tier (PostgreSQL) — durable storage
PGHOST=localhost
PGPORT=5432
PGUSER=cloudlab
PGPASSWORD=change-me
PGDATABASE=cloudlab
# Set to "require" for managed Postgres that enforces TLS (e.g. Azure
# Database for PostgreSQL Flexible Server). Leave unset for self-hosted
# Postgres on a private subnet (Acronis, AWS RDS default in this repo).
PGSSLMODE=

# Cache tier (Redis) — fast, ephemeral counters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
