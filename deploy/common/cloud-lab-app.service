[Unit]
Description=Cloud Lab Guestbook app server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/cloud-lab-app
EnvironmentFile=/opt/cloud-lab-app/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
